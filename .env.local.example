# Copy this file to .env.local and fill in your own values.

# Random signing secret for auth sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ---------------------------------------------------------------------------
# AI providers — the tutor tries these in order (see AI_PROVIDER_ORDER below)
# and falls through to the next one if a provider fails or isn't configured.
# You only need ONE of these to run the app; add more for redundancy.
# Free-tier signup links:
#   Google Gemini  -> https://aistudio.google.com/apikey
#   Groq           -> https://console.groq.com/keys
#   OpenRouter     -> https://openrouter.ai/keys (has free models)
#   Anthropic      -> https://console.anthropic.com/settings/keys (paid)
#   OpenAI         -> https://platform.openai.com/api-keys (paid)
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional: override the failover order (comma-separated provider ids).
# Default is: google,groq,anthropic,openrouter,openai
# AI_PROVIDER_ORDER=google,groq,anthropic,openrouter,openai

# Optional: override the default model id per provider.
# GOOGLE_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Email (Resend) — sends real class-confirmation emails when a student
# schedules a session and picks "correo" as a reminder channel.
# Get a key at https://resend.com/api-keys (free tier: 3,000 emails/month).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a domain verified in Resend, or the resend.dev sandbox address below.
RESEND_FROM_EMAIL="Prixo <onboarding@resend.dev>"

# Google OAuth client — powers "Continuar con Google" login AND the
# separate "Conectar Google Calendar" connector (per-student, see
# src/lib/googleCalendar.ts). Create one at
# https://console.cloud.google.com/apis/credentials — needs the Calendar
# API enabled and both scopes (userinfo.email/profile + calendar.events)
# added on the consent screen, plus redirect URIs for both
# /api/auth/callback/google and /api/connectors/google-calendar/callback.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Slack Incoming Webhook — internal ops alerts only (new class scheduled,
# AI providers all down, admin panel login). Create one at
# https://api.slack.com/apps -> your app -> Incoming Webhooks.
SLACK_WEBHOOK_URL=

# Comma-separated emails allowed into Panel admin.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Private admin login (usuario y contraseña) at /admin-login — separate from
# the student login, for the team only. ADMIN_LOGIN_EMAIL must also be
# included in ADMIN_EMAILS above. Generate a fresh username/password/hash
# with:
#   node -e "const b=require('bcryptjs'),c=require('crypto');const u='admin_'+c.randomBytes(3).toString('hex');const p=c.randomBytes(9).toString('base64').replace(/[+/=]/g,x=>({'+':'A','/':'B','=':''}[x]));console.log('USERNAME='+u);console.log('PASSWORD='+p);console.log('HASH='+b.hashSync(p,10));"
#
# IMPORTANT: escape every `$` in the printed HASH as `\$` before pasting it
# below — Next.js's env loader treats an unescaped `$word` as a reference to
# another env var and silently blanks it out, since bcrypt hashes look like
# `$2b$10$...`. Example: `$2b$10$xvo...` becomes `\$2b\$10\$xvo...`.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_EMAIL=

# ---------------------------------------------------------------------------
# Database (Postgres) — powers the admin-editable content: learning
# materials, email template overrides, knowledge sources. Without this the
# app still runs, but those admin panels show "Base de datos no configurada"
# and can't save. Create one for free at Vercel -> Storage -> Create
# Database -> Postgres (Neon), connect it to the project, then copy the
# pooled connection string it gives you (POSTGRES_URL or DATABASE_URL).
# After setting this, run `npm run db:push` to create the tables.
# ---------------------------------------------------------------------------
POSTGRES_URL=

# ---------------------------------------------------------------------------
# SEO / analytics — all optional, but recommended before going live.
# ---------------------------------------------------------------------------
# Your real production domain, no trailing slash. Used in the sitemap,
# robots.txt, canonical URLs and Open Graph tags. Update this the moment you
# have a real domain — it currently falls back to a placeholder.
NEXT_PUBLIC_SITE_URL=https://prixo.vercel.app

# Google Analytics 4 Measurement ID (starts with "G-"). Create a GA4 property
# at https://analytics.google.com — Admin -> Data Streams -> Web.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification code (the "content" value from the HTML
# tag method, not the whole tag). https://search.google.com/search-console
# -> Add property -> HTML tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
