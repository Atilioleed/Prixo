# Copy this file to .env.local and fill in your own values.

# Random signing secret for auth sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ---------------------------------------------------------------------------
# AI providers — the tutor tries these in order (see AI_PROVIDER_ORDER below)
# and falls through to the next one if a provider fails or isn't configured.
# You only need ONE of these to run the app; add more for redundancy.
# Free-tier signup links:
#   Google Gemini  -> https://aistudio.google.com/apikey
#   Groq           -> https://console.groq.com/keys
#   OpenRouter     -> https://openrouter.ai/keys (has free models)
#   Anthropic      -> https://console.anthropic.com/settings/keys (paid)
#   OpenAI         -> https://platform.openai.com/api-keys (paid)
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional: override the failover order (comma-separated provider ids).
# Default is: google,groq,anthropic,openrouter,openai
# AI_PROVIDER_ORDER=google,groq,anthropic,openrouter,openai

# Optional: override the default model id per provider.
# GOOGLE_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Email (Resend) — sends real class-confirmation emails when a student
# schedules a session and picks "correo" as a reminder channel.
# Get a key at https://resend.com/api-keys (free tier: 3,000 emails/month).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a domain verified in Resend, or the resend.dev sandbox address below.
RESEND_FROM_EMAIL="Prixo <onboarding@resend.dev>"

# Google OAuth client, for "Continuar con Google". Create one at
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails allowed into Panel admin.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# SEO / analytics — all optional, but recommended before going live.
# ---------------------------------------------------------------------------
# Your real production domain, no trailing slash. Used in the sitemap,
# robots.txt, canonical URLs and Open Graph tags. Update this the moment you
# have a real domain — it currently falls back to a placeholder.
NEXT_PUBLIC_SITE_URL=https://prixo.vercel.app

# Google Analytics 4 Measurement ID (starts with "G-"). Create a GA4 property
# at https://analytics.google.com — Admin -> Data Streams -> Web.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification code (the "content" value from the HTML
# tag method, not the whole tag). https://search.google.com/search-console
# -> Add property -> HTML tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
